{
  "name": "huntsignal",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:remote": "tsx scripts/dev.ts --remote",
    "alerts": "tsx ingestion/alerts-cli.ts",
    "ops": "tsx scripts/operations.ts",
    "backup:hosted": "tsx scripts/backup-hosted.ts",
    "backup:restore": "tsx scripts/restore-hosted-backup.ts",
    "build": "tsc --noEmit && vite build",
    "prebuild": "tsx scripts/check-assets.ts && tsx scripts/prepare-auth.ts",
    "auth:publish-config": "tsx scripts/publish-auth.ts",
    "auth:check": "tsx scripts/check-auth.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest": "tsx ingestion/cli.ts",
    "capture": "tsx ingestion/capture-cli.ts",
    "config:check": "tsx ingestion/check-config.ts",
    "models:prepare": "tsx scripts/prepare-model.ts",
    "enrich": "tsx ingestion/enrich-cli.ts",
    "search:eval": "tsx scripts/evaluate-search.ts",
    "test:wasm": "tsx scripts/verify-wasm.ts",
    "pilot": "tsx ingestion/cli.ts pilot --limit 500",
    "export": "tsx scripts/export.ts",
    "restore": "tsx scripts/restore.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:phase2": "tsx scripts/smoke-phase2.ts",
    "smoke:phase3": "tsx scripts/smoke-phase3.ts",
    "smoke:phase4": "tsx scripts/smoke-phase4.ts",
    "smoke:phase5": "tsx scripts/smoke-phase5.ts",
    "smoke:capture": "tsx scripts/smoke-capture.ts",
    "format": "prettier --write apps packages ingestion scripts tests *.ts *.json *.jsonc *.md docs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "@hono/node-server": "^1.19.0",
    "@huggingface/transformers": "^4.3.1",
    "@mozilla/readability": "^0.6.0",
    "@supabase/supabase-js": "^2.118.0",
    "fast-xml-parser": "^5.3.0",
    "hono": "^4.10.0",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.0.0",
    "libsodium-wrappers": "^0.8.4",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.45.0"
  }
}
