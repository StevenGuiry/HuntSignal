# The ingestion CLI loads .env automatically. Existing terminal variables win.
# Local development needs no credentials. Use --remote for Supabase ingestion.
SUPABASE_URL=
# Accepts either a legacy service_role JWT or a modern sb_secret_ key.
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe key for GitHub sign-in (sb_publishable_... or legacy anon).
SUPABASE_PUBLISHABLE_KEY=
ARCHIVE_BUCKET=archive
# Optional HackerOne discovery. Never place these in a VITE_* variable.
HACKERONE_USERNAME=
HACKERONE_API_TOKEN=
# Optional independent backup destination; keep the encryption key elsewhere.
HUNTSIGNAL_BACKUP_DIR=
HUNTSIGNAL_BACKUP_KEY_FILE=
